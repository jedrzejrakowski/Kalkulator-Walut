# Kalkulator walut NBP — usługa systemowa na VPS.
#
# Pliki aplikacji i serwer przychodzą z GitHub Actions (rsync jako deploy):
#   /srv/apps/kalkulator/                 aplikacja (dist/)
#   /srv/apps/kalkulator-serwer/serwer.mjs serwer z logowaniem
# Konta i klucz sesji leżą w /var/lib/kalkulator-walut, dostępne tylko dla usługi.

[Unit]
Description=Kalkulator walut NBP
Documentation=https://github.com/jedrzejrakowski/Kalkulator-Walut
After=network.target

[Service]
Type=simple
User=kalkulator
Group=kalkulator
ExecStart=/usr/bin/node /srv/apps/kalkulator-serwer/serwer.mjs
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8080
Environment=KATALOG=/srv/apps/kalkulator
# Katalog stanu tworzy systemd, z prawami tylko dla usługi; ścieżkę podaje
# w zmiennej STATE_DIRECTORY.
StateDirectory=kalkulator-walut
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=3

# Usługa potrzebuje tylko czytać pliki aplikacji, pisać do własnego katalogu
# stanu i słuchać na porcie — wszystko inne jest jej odebrane.
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target

# Kalkulator walut NBP — usługa systemowa na VPS.
# Instaluje ją vps/instaluj.sh; po zmianach: sudo bash vps/aktualizuj.sh

[Unit]
Description=Kalkulator walut NBP
Documentation=https://github.com/jedrzejrakowski/Kalkulator-Walut
After=network.target

[Service]
Type=simple
User=kalkulator
Group=kalkulator
WorkingDirectory=/opt/kalkulator-walut
ExecStart=/usr/bin/node /opt/kalkulator-walut/dist-vps/serwer.mjs
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8080
# Plik hasła czyta tylko root; usługa dostaje od systemd własną kopię.
LoadCredential=haslo:/etc/kalkulator-walut/haslo
Restart=on-failure
RestartSec=3

# Usługa potrzebuje tylko czytać własne pliki i słuchać na porcie —
# wszystko inne jest jej odebrane, na wypadek błędu w programie.
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
